# Live-verify harness env. Copy to .env and `set -a; source .env; set +a`
# (or use your shell's dotenv loader). Fill only the providers you are testing.

# --- Harness -----------------------------------------------------------------
DATABASE_URL=postgres://paykit:paykit@localhost:5432/paykit
PORT=4242
ADMIN_SECRET=live-verify-admin
# Tunnel URL that providers can reach (cloudflared/ngrok). REQUIRED for webhooks:
#   cloudflared tunnel --url http://localhost:4242
PUBLIC_BASE_URL=

# --- NowPayments (public sandbox: account at account.sandbox.nowpayments.io) --
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_ENVIRONMENT=sandbox
# Pin one USDT chain, or leave empty for customer choice on the pay page:
#   usdtbsc (BEP20) | usdttrc20 (TRC20) | usdterc20 (ERC20) | usdtmatic (Polygon)
NOWPAYMENTS_PAY_CURRENCY=

# --- Cryptomus (merchant dashboard: cryptomus.com) -----------------------------
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_PAYMENT_API_KEY=
# Pin coin/chain, or leave empty for customer choice:
#   CRYPTOMUS_NETWORK: bsc (BEP20) | tron (TRC20) | eth (ERC20) | polygon
CRYPTOMUS_TO_CURRENCY=
CRYPTOMUS_NETWORK=

# --- Binance Pay (LIVE — no sandbox; merchant.binance.com) ---------------------
# Run `pnpm clock-check` first: requests outside ~1s of Binance's clock fail 400003.
# Get BINANCE_WEBHOOK_PUBLIC_KEY via `pnpm binance-cert` after filling key+secret.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_WEBHOOK_PUBLIC_KEY=

# --- BitPay (sandbox: test.bitpay.com) -----------------------------------------
BITPAY_API_TOKEN=
BITPAY_ENVIRONMENT=sandbox
# Merchant-facade ECDSA private key (64 hex chars from the BitPay SDK, or a
# secp256k1 PEM). Optional — without it checkout works but refunds and
# reconciliation are disabled.
BITPAY_MERCHANT_PRIVATE_KEY=

# --- Coinbase Commerce (beta.commerce.coinbase.com) -----------------------------
# Webhook URL cannot be set per-charge: register
# ${PUBLIC_BASE_URL}/webhooks/coinbase-commerce in the Coinbase dashboard.
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=
