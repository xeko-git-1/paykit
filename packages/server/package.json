{
  "name": "@vibecc/paykit-server",
  "version": "0.3.0-rc.0",
  "description": "Paykit server: Hono routes (checkout, webhooks, billing, admin), DB schema, repos, provider clients",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xeko-git-1/paykit.git",
    "directory": "packages/server"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vibecc/paykit": "workspace:*",
    "@vibecc/paykit-auth-core": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@vibecc/paykit-sepay": "workspace:^",
    "@vibecc/paykit-stripe": "workspace:^",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "pg": "^8.13.0",
    "stripe": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "@vibecc/paykit-stripe": { "optional": true },
    "@vibecc/paykit-sepay": { "optional": true },
    "stripe": { "optional": true }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
