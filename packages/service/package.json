{
  "name": "@xeko-git-1/paykit-service",
  "version": "0.4.0-rc.0",
  "description": "Paykit standalone service shell — Hono + Node HTTP server, auth middleware, health checks, Docker-ready",
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xeko-git-1/paykit.git",
    "directory": "packages/service"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js serve",
    "dev": "tsx src/main.ts serve"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@hono/zod-openapi": "^1.4.0",
    "@xeko-git-1/paykit": "workspace:*",
    "@xeko-git-1/paykit-binance": "workspace:*",
    "@xeko-git-1/paykit-cli": "workspace:*",
    "@xeko-git-1/paykit-cryptomus": "workspace:*",
    "@xeko-git-1/paykit-momo": "workspace:*",
    "@xeko-git-1/paykit-nowpayments": "workspace:*",
    "@xeko-git-1/paykit-sepay": "workspace:*",
    "@xeko-git-1/paykit-server": "workspace:*",
    "@xeko-git-1/paykit-stripe": "workspace:*",
    "@xeko-git-1/paykit-vnpay": "workspace:*",
    "@xeko-git-1/paykit-zalopay": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.0",
    "pg": "^8.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0"
  },
  "engines": {
    "node": ">=20"
  }
}
