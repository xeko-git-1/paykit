{
  "name": "@xeko-git-1/paykit-cli",
  "version": "0.1.5",
  "description": "Paykit CLI: paykit migrate (advisory-locked), paykit doctor, paykit --version",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "paykit": "./dist/bin/paykit.js"
  },
  "files": ["dist", "migrations"],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xeko-git-1/paykit.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm copy:migrations",
    "copy:migrations": "node -e \"require('node:fs').cpSync('../../migrations','./migrations',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@xeko-git-1/paykit-auth-core": "workspace:*",
    "cac": "^6.7.14",
    "drizzle-orm": "^0.36.4",
    "pg": "^8.13.0"
  },
  "peerDependencies": {
    "@xeko-git-1/paykit": ">=0.1.5 <0.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@xeko-git-1/paykit": "workspace:*",
    "hono": "^4.6.0"
  }
}
