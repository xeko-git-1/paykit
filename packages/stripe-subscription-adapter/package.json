{
  "name": "@vibecc/paykit-stripe-subscription",
  "version": "0.2.1",
  "description": "Paykit V2 adapter for Stripe Subscriptions — pass-through over stripe.subscriptions.{create,cancel,update,list}; webhook normalization for 10 events",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xeko-git-1/paykit.git",
    "directory": "packages/stripe-subscription-adapter"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vibecc/paykit": "workspace:*"
  },
  "peerDependencies": {
    "stripe": "^18.0.0"
  },
  "engines": { "node": ">=20" }
}
