{
  "name": "@xeko-git-1/paykit-creem",
  "version": "0.3.0-rc.0",
  "description": "Paykit adapter for Creem.io — checkout sessions over a pre-created product, creem-signature (HMAC-SHA256) webhook verify, licensing metadata pass-through. Refunds are dashboard-only on Creem's side (adapter reports 'unsupported' and credits the ledger when the refund webhook arrives).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xeko-git-1/paykit.git",
    "directory": "packages/creem-adapter"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {
    "@xeko-git-1/paykit": ">=0.3.0-rc.0 <0.4.0"
  },
  "devDependencies": {
    "@xeko-git-1/paykit": "workspace:*"
  },
  "engines": { "node": ">=20" }
}
