{
  "name": "@xeko-git-1/paykit-paddle",
  "version": "0.3.0-rc.0",
  "description": "Paykit adapter for Paddle Billing — one-off transactions with inline (non-catalog) prices, Paddle-Signature webhook verify, refunds via the adjustments API (merchant-of-record approval flow), transaction listing for reconciliation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xeko-git-1/paykit.git",
    "directory": "packages/paddle-adapter"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {
    "@xeko-git-1/paykit": ">=0.3.0-rc.0 <0.4.0"
  },
  "devDependencies": {
    "@xeko-git-1/paykit": "workspace:*"
  },
  "engines": { "node": ">=20" }
}
